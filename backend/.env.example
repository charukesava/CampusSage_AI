PORT=4000
DATABASE_URL=postgresql://campussage:campussage@localhost:5432/campussage
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads

# Get a key at https://aistudio.google.com/apikey
# Required for real AI answers and document search (RAG). Without it, uploaded
# documents are still text-extracted and searchable by keyword, and chat replies
# with a message explaining that AI answering isn't configured yet.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Must match the vector(...) column size in schema.sql if you change it.
GEMINI_EMBEDDING_DIMENSIONS=768

# Timetable image import fallback when the uploaded timetable shows period numbers but no clock times.
# The current timetable grid uses 08:00 as period 1 and 60-minute periods by default.
TIMETABLE_FIRST_PERIOD_MINUTES=480
TIMETABLE_PERIOD_MINUTES=60

# Optional: upcoming-class email reminders (Settings > Email notifications must
# also be turned on by the student). Without these, the app still works
# normally and in-app/browser pop-up reminders keep working - only the email
# is skipped. For Gmail, use an "App password", not your normal password.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
# How many minutes before a class starts the reminder email is sent.
CLASS_REMINDER_MINUTES_BEFORE=10
